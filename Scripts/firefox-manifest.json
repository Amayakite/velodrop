{
  "manifest_version": 3,
  "name": "VeloDrop",
  "short_name": "VeloDrop",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "0.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "velodrop@amayakite.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "incognito": "not_allowed",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "alarms",
    "webRequest",
    "proxy"
  ],
  "background": {
    "scripts": ["worker.js"],
    "type": "module"
  },
  "action": {
    "default_title": "VeloDrop",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "Icon16.png",
    "32": "Icon32.png",
    "48": "Icon48.png",
    "128": "Icon128.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
